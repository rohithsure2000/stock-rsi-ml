# Copy this file to .env and fill in values as needed.
# None of these are required for the default synthetic-data pipeline run;
# they're only used when running with --real-data against a live/paid
# market data provider.

# Ticker to analyze by default (overridden by --ticker CLI flag)
DEFAULT_TICKER=AAPL

# Optional: API key if you swap the yfinance loader for a paid provider
# (e.g. Alpha Vantage, Polygon.io, IEX Cloud) instead of yfinance.
MARKET_DATA_API_KEY=

# Optional: Databricks connection info, only used by
# notebooks/databricks_pyspark_pipeline.py when run on a real cluster.
DATABRICKS_HOST=
DATABRICKS_TOKEN=
